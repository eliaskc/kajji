{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "JSON Schema reference for editor autocomplete",
            "type": "string"
        },
        "ui": {
            "default": {
                "theme": "kajji",
                "themeMode": "system",
                "syntaxTheme": {},
                "showFileTree": true
            },
            "description": "UI settings",
            "type": "object",
            "properties": {
                "theme": {
                    "description": "Color theme",
                    "default": "kajji",
                    "type": "string",
                    "enum": ["kajji"]
                },
                "themeMode": {
                    "default": "system",
                    "description": "Color mode: follow system/terminal, or force dark/light",
                    "type": "string",
                    "enum": ["system", "dark", "light"]
                },
                "syntaxTheme": {
                    "default": {},
                    "description": "Override syntax highlighting themes for dark/light modes",
                    "type": "object",
                    "properties": {
                        "dark": {
                            "type": "string",
                            "enum": [
                                "andromeeda",
                                "aurora-x",
                                "ayu-dark",
                                "ayu-light",
                                "ayu-mirage",
                                "catppuccin-frappe",
                                "catppuccin-latte",
                                "catppuccin-macchiato",
                                "catppuccin-mocha",
                                "dark-plus",
                                "dracula",
                                "dracula-soft",
                                "everforest-dark",
                                "everforest-light",
                                "github-dark",
                                "github-dark-default",
                                "github-dark-dimmed",
                                "github-dark-high-contrast",
                                "github-light",
                                "github-light-default",
                                "github-light-high-contrast",
                                "gruvbox-dark-hard",
                                "gruvbox-dark-medium",
                                "gruvbox-dark-soft",
                                "gruvbox-light-hard",
                                "gruvbox-light-medium",
                                "gruvbox-light-soft",
                                "horizon",
                                "horizon-bright",
                                "houston",
                                "kanagawa-dragon",
                                "kanagawa-lotus",
                                "kanagawa-wave",
                                "laserwave",
                                "light-plus",
                                "material-theme",
                                "material-theme-darker",
                                "material-theme-lighter",
                                "material-theme-ocean",
                                "material-theme-palenight",
                                "min-dark",
                                "min-light",
                                "monokai",
                                "night-owl",
                                "night-owl-light",
                                "nord",
                                "one-dark-pro",
                                "one-light",
                                "pierre-dark",
                                "pierre-dark-protanopia-deuteranopia",
                                "pierre-dark-soft",
                                "pierre-dark-tritanopia",
                                "pierre-dark-vibrant",
                                "pierre-light",
                                "pierre-light-protanopia-deuteranopia",
                                "pierre-light-soft",
                                "pierre-light-tritanopia",
                                "pierre-light-vibrant",
                                "plastic",
                                "poimandres",
                                "red",
                                "rose-pine",
                                "rose-pine-dawn",
                                "rose-pine-moon",
                                "slack-dark",
                                "slack-ochin",
                                "snazzy-light",
                                "solarized-dark",
                                "solarized-light",
                                "synthwave-84",
                                "tokyo-night",
                                "vesper",
                                "vitesse-black",
                                "vitesse-dark",
                                "vitesse-light"
                            ]
                        },
                        "light": {
                            "type": "string",
                            "enum": [
                                "andromeeda",
                                "aurora-x",
                                "ayu-dark",
                                "ayu-light",
                                "ayu-mirage",
                                "catppuccin-frappe",
                                "catppuccin-latte",
                                "catppuccin-macchiato",
                                "catppuccin-mocha",
                                "dark-plus",
                                "dracula",
                                "dracula-soft",
                                "everforest-dark",
                                "everforest-light",
                                "github-dark",
                                "github-dark-default",
                                "github-dark-dimmed",
                                "github-dark-high-contrast",
                                "github-light",
                                "github-light-default",
                                "github-light-high-contrast",
                                "gruvbox-dark-hard",
                                "gruvbox-dark-medium",
                                "gruvbox-dark-soft",
                                "gruvbox-light-hard",
                                "gruvbox-light-medium",
                                "gruvbox-light-soft",
                                "horizon",
                                "horizon-bright",
                                "houston",
                                "kanagawa-dragon",
                                "kanagawa-lotus",
                                "kanagawa-wave",
                                "laserwave",
                                "light-plus",
                                "material-theme",
                                "material-theme-darker",
                                "material-theme-lighter",
                                "material-theme-ocean",
                                "material-theme-palenight",
                                "min-dark",
                                "min-light",
                                "monokai",
                                "night-owl",
                                "night-owl-light",
                                "nord",
                                "one-dark-pro",
                                "one-light",
                                "pierre-dark",
                                "pierre-dark-protanopia-deuteranopia",
                                "pierre-dark-soft",
                                "pierre-dark-tritanopia",
                                "pierre-dark-vibrant",
                                "pierre-light",
                                "pierre-light-protanopia-deuteranopia",
                                "pierre-light-soft",
                                "pierre-light-tritanopia",
                                "pierre-light-vibrant",
                                "plastic",
                                "poimandres",
                                "red",
                                "rose-pine",
                                "rose-pine-dawn",
                                "rose-pine-moon",
                                "slack-dark",
                                "slack-ochin",
                                "snazzy-light",
                                "solarized-dark",
                                "solarized-light",
                                "synthwave-84",
                                "tokyo-night",
                                "vesper",
                                "vitesse-black",
                                "vitesse-dark",
                                "vitesse-light"
                            ]
                        }
                    }
                },
                "showFileTree": {
                    "default": true,
                    "description": "Show files as tree (false for flat list)",
                    "type": "boolean"
                }
            }
        },
        "diff": {
            "default": {
                "layout": "auto",
                "autoSwitchWidth": 120,
                "wrap": true,
                "engine": "textual"
            },
            "description": "Diff display settings",
            "type": "object",
            "properties": {
                "layout": {
                    "default": "auto",
                    "description": "Diff layout mode: auto switches based on autoSwitchWidth, unified/split are fixed",
                    "type": "string",
                    "enum": ["auto", "unified", "split"]
                },
                "autoSwitchWidth": {
                    "default": 120,
                    "description": "Auto-switch to split view above this terminal width (only used when layout is auto)",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                },
                "wrap": {
                    "default": true,
                    "description": "Wrap long lines in diff view",
                    "type": "boolean"
                },
                "engine": {
                    "default": "textual",
                    "description": "Diff engine: textual (built-in), structural (Difftastic, requires difft on PATH, falls back to textual), or jj-formatter (jj's ui.diff-formatter output)",
                    "type": "string",
                    "enum": ["textual", "structural", "jj-formatter"]
                }
            }
        },
        "gitHooksPath": {
            "description": "Path to a Git-compatible hooks directory, or false to disable core.hooksPath discovery",
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "boolean",
                    "const": false
                }
            ]
        },
        "repos": {
            "default": {},
            "description": "Repository-specific configuration keyed by repository path",
            "type": "object",
            "propertyNames": {
                "type": "string"
            }
        },
        "whatsNewDisabled": {
            "default": false,
            "description": "Disable the what's new screen on updates",
            "type": "boolean"
        },
        "autoUpdatesDisabled": {
            "default": false,
            "description": "Disable automatic update checks and installs",
            "type": "boolean"
        }
    },
    "description": "kajji configuration",
    "allowComments": true,
    "allowTrailingCommas": true
}
